# Base de datos (Supabase / Neon / PostgreSQL)
# Ejemplo Supabase: postgresql://postgres:[TU_PASSWORD]@db.[REF].supabase.co:5432/postgres?pgbouncer=true
# Ejemplo Neon: postgresql://[USER]:[PASSWORD]@[ENDPOINT].neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/farmacia_db?schema=public"

# Autenticación y Seguridad
JWT_SECRET="sistema-farmacia-bolivia-secret-token-key-2026-xyz"
NEXTAUTH_SECRET="sistema-farmacia-bolivia-nextauth-secret-key-2026"
NEXTAUTH_URL="http://localhost:3000"

# Configuración del Sistema
NEXT_PUBLIC_APP_NAME="Sistema de Farmacia - Bolivia"
